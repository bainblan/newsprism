# newsprism backend configuration. Copy to .env and edit as needed.
# .env is gitignored — this repo is public, never commit a real .env.

# Path to the SQLite file. Relative paths resolve against backend/.
NEWSPRISM_DB_PATH=data/newsprism.db

# Which clustering implementation to use: "embedding" (sentence-transformers,
# the default) or "tfidf" (scikit-learn fallback, no torch required).
NEWSPRISM_CLUSTERER=embedding

# Cosine-similarity threshold for merging two articles into one story.
# Higher = tighter clusters. Tuned on live feed data; see backend/README.md.
NEWSPRISM_SIMILARITY_THRESHOLD=0.62

# Sentence-transformers model id (CPU).
NEWSPRISM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Only articles published within this many days are clustered.
NEWSPRISM_CLUSTER_WINDOW_DAYS=4

# Per-feed HTTP timeout in seconds, and how many times to retry a feed.
NEWSPRISM_FEED_TIMEOUT_SECONDS=15
NEWSPRISM_FEED_RETRIES=2

# CORS origins, comma separated.
NEWSPRISM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
