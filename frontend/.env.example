# Copy to .env.local and adjust. Restart `npm run dev` after any change —
# NEXT_PUBLIC_* values are inlined at build time, not read at runtime.

# Base URL of the FastAPI backend. The browser calls it directly, so this must
# be reachable from the browser, not just from the Next.js server.
# Defaults to http://localhost:8000 when unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- development only -------------------------------------------------------
# Serve every API call from src/lib/mock/mock-api.ts instead of the network, so
# the UI can be worked on with no backend running. Leave unset for real data.
# NEXT_PUBLIC_USE_MOCK_DATA=true

# Which fixture the mock serves. Only read when NEXT_PUBLIC_USE_MOCK_DATA=true.
#   stories  (default) a populated list
#   no_data            503 NO_DATA — see NEXT_PUBLIC_SHOW_INGEST_CONTROL below
#                       for whether this state offers a button
#   empty              200 with an empty stories array
#   error              500 INTERNAL
#   offline            no response at all, as if the backend were down
# NEXT_PUBLIC_MOCK_SCENARIO=stories

# Show the "run ingest" button in the UI (NoDataState, the sparse empty state,
# and the populated list's header). Defaults to off. POST /api/ingest now
# requires a shared secret (X-Ingest-Token) that a NEXT_PUBLIC_* value can
# never hold, since Next inlines it into the JS bundle anyone can read — so
# this must stay unset (or anything other than "true") on a deployed instance.
# Set it to "true" for local development against a real backend, where a fresh
# clone has no NEWSPRISM_INGEST_TOKEN configured (so the endpoint is open) and
# you are the only one who can reach the button anyway.
# NEXT_PUBLIC_SHOW_INGEST_CONTROL=true
