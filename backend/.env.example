# newsprism backend configuration. Copy to .env and edit as needed.
# .env is gitignored — this repo is public, never commit a real .env.

# Path to the SQLite file. Relative paths resolve against backend/.
NEWSPRISM_DB_PATH=data/newsprism.db

# Which clustering implementation to use: "onnx" (ONNX Runtime, the default,
# no torch required), "embedding" (the torch/sentence-transformers reference
# implementation — needs `pip install -r requirements-torch.txt`), or "tfidf"
# (scikit-learn fallback, much weaker, no model download at all).
NEWSPRISM_CLUSTERER=onnx

# Cosine-similarity threshold for merging two articles into one story.
# Higher = tighter clusters. Tuned on live feed data; see backend/README.md.
NEWSPRISM_SIMILARITY_THRESHOLD=0.62

# HF hub model id. Used to fetch onnx/model.onnx + tokenizer.json for the
# "onnx" clusterer, or loaded via sentence-transformers for "embedding".
# Downloaded on first use via huggingface_hub and cached under HF_HOME
# (defaults to ~/.cache/huggingface).
NEWSPRISM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Only articles published within this many days are clustered.
NEWSPRISM_CLUSTER_WINDOW_DAYS=4

# Minimum containment (overlap / min(|new group|, |old story's in-window
# members|)) for a freshly clustered group to inherit an existing story's id
# instead of minting a new one. See docs/api-contract.md's "ID stability".
NEWSPRISM_ID_CONTAINMENT_THRESHOLD=0.5

# Per-feed HTTP timeout in seconds, and how many times to retry a feed.
NEWSPRISM_FEED_TIMEOUT_SECONDS=15
NEWSPRISM_FEED_RETRIES=2

# CORS origins, comma separated.
NEWSPRISM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Shared secret required in the "X-Ingest-Token" header on POST /api/ingest
# (see docs/api-contract.md v1.2). Unset (the default) means the endpoint is
# OPEN - fine for a fresh local clone, wrong for a deployment, since ingest is
# a multi-minute CPU-bound run anyone with the URL could otherwise trigger.
# This is a real secret, not a config knob: generate a random value for any
# deployed instance, and never commit it. .env is gitignored because this
# repo is public - a value committed here would be exposed immediately and
# would stay in git history even after being removed.
NEWSPRISM_INGEST_TOKEN=

# How many seconds must pass between successful ingest runs before an
# anonymous caller (no token, or NEWSPRISM_INGEST_TOKEN unset) gets another
# one (see docs/api-contract.md v1.3). A caller with a valid token bypasses
# this. Default 900 (15 minutes) - feeds barely move in less time than that,
# so this bounds total work without making the button useless.
NEWSPRISM_INGEST_COOLDOWN_SECONDS=900
